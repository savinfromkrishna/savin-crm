{
  "name": "savingroup",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none turbo dev --filter=@savingroup/api --filter=@savingroup/worker --filter=@savingroup/web",
    "dev:api": "cross-env BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none pnpm --filter @savingroup/api dev",
    "dev:web": "pnpm --filter @savingroup/web dev",
    "dev:worker": "cross-env BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none pnpm --filter @savingroup/worker dev",
    "build": "turbo build",
    "start": "cross-env NODE_ENV=production BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none pnpm --filter @savingroup/api start",
    "start:api": "cross-env NODE_ENV=production BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none pnpm --filter @savingroup/api start",
    "start:worker": "cross-env NODE_ENV=production BUSINESS_APPS_ENABLED=true TICKET_BOARD_ENABLED=true SANDBOX_PROVIDER=none pnpm --filter @savingroup/worker start",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @savingroup/db generate",
    "db:migrate": "pnpm --filter @savingroup/db migrate",
    "db:seed": "tsx scripts/seed-crm.ts",
    "test": "vitest run",
    "test:crm": "vitest run packages/business/src apps/api/src/business-app.postgres.test.ts",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @savingroup/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "ios:screenshots": "pnpm --filter @savingroup/db generate && tsx packages/testkit/src/cli/ios-app-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:reliability": "tsx packages/testkit/src/cli/reliability.ts",
    "demo:reliability": "tsx packages/testkit/src/cli/reliability-demo.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "e2b>undici8": "npm:undici@8.10.2"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch",
      "@earendil-works/pi-ai@0.87.1": "patches/@earendil-works__pi-ai@0.87.1.patch"
    }
  }
}
