# Copy to infra/frappe/.env (gitignored). Every value here is a placeholder.

# Image built from infra/frappe/Containerfile (see README.md).
SAVINGROUP_FRAPPE_IMAGE=savingroup/frappe-business:16.51.1

# Host port for the site's HTTP front door.
FRAPPE_HTTP_PORT=8090

# Site name inside the bench; nginx routes every host header to it.
SITE_NAME=frontend

# Secrets. Generate long random values; never reuse them anywhere else.
MARIADB_ROOT_PASSWORD=change-me-db-root
SITE_ADMIN_PASSWORD=change-me-site-admin
SITE_ADMIN_EMAIL=admin@example.com

# Blueprint: india-smb or generic (infra/frappe/blueprints/*.json).
BLUEPRINT=india-smb
COMPANY_NAME=Example Trading Pvt Ltd
COMPANY_ABBR=ETP

# The user Savingroup authenticates as. Standard roles only, never Administrator.
GATEWAY_USER_EMAIL=savingroup-gateway@example.com

# ERPNext Stock Settings for the site (0 = stock may not go negative).
ALLOW_NEGATIVE_STOCK=0

# 1 = also give the gateway user the administrative roles at provisioning, so the
# Savingroup Operator can set up and automate the site unattended (see README,
# "Autonomous operation"). Can be granted later with setup.grant_admin.
GATEWAY_ADMIN=0
