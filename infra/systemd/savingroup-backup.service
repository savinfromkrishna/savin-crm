[Unit]
Description=Create and verify a Savingroup production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/savingroup/backup.env
ExecStart=/usr/local/sbin/savingroup-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
