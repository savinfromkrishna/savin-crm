  id              String          @id @default(cuid())
  boardId         String
  board           Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  description     String?
  status          String          @default("todo")
  priority        String?
  assigneeBotId   String?
  assigneeBot     Bot?            @relation("TicketAssigneeBot", fields: [assigneeBotId], references: [id], onDelete: SetNull)
  createdByBotId  String?
  createdByBot    Bot?            @relation("TicketCreatorBot", fields: [createdByBotId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByUser   User?           @relation("TicketCreatorUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?
  comments        TicketComment[]

  @@unique([boardId, number])
  @@index([spaceId, status])
  @@index([boardId, status])
  @@map("tickets")
}

model TicketComment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorBotId  String?
  authorBot    Bot?     @relation("TicketCommentAuthorBot", fields: [authorBotId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?    @relation("TicketCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// ---------------------------------------------------------------------------
// Business applications (CRM OS and ERP OS). Every record belongs to one Space.
// Actor columns (createdBy*, assignee*, approvedBy*) are plain ids on purpose:
// they are display attribution resolved at read time, not ownership, so a
// removed bot or user leaves history intact without a relation on Bot/User.
// ---------------------------------------------------------------------------

model BusinessSettings {
  id                      String   @id @default(cuid())
  spaceId                 String   @unique
  space                   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  currency                String   @default("USD")
  allowNegativeStock      Boolean  @default(false)
  orderApprovalRequired   Boolean  @default(true)
  invoiceApprovalRequired Boolean  @default(true)
  nextLeadNumber          Int      @default(1)
  nextDealNumber          Int      @default(1)
  nextOrderNumber         Int      @default(1)
  nextInvoiceNumber       Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("business_settings")
}

model CrmCompany {
  id              String          @id @default(cuid())
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name            String
  domain          String?
  phone           String?
  notes           String?
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contacts        CrmContact[]
  leads           CrmLead[]
  deals           CrmDeal[]
  activities      CrmActivity[]
  orders          ErpSalesOrder[]
  invoices        ErpInvoice[]

  @@index([spaceId, name])
  @@map("crm_companies")
}

model CrmContact {
  id              String          @id @default(cuid())
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String          @default("")
  email           String?
  phone           String?
  title           String?
  notes           String?
  companyId       String?
  company         CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  leads           CrmLead[]
  deals           CrmDeal[]
  activities      CrmActivity[]
  orders          ErpSalesOrder[]

  @@index([spaceId, email])
  @@index([spaceId, companyId])
  @@index([spaceId, lastName, firstName])
  @@map("crm_contacts")
}

model CrmLead {
  id              String        @id @default(cuid())
  spaceId         String
  space           Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  status          String        @default("new")
  source          String?
  notes           String?
  value           Decimal?      @db.Decimal(14, 2)
  companyId       String?
  company         CrmCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeUserId  String?
  assigneeBotId   String?
  convertedDealId String?       @unique
  convertedDeal   CrmDeal?      @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activities      CrmActivity[]

  @@unique([spaceId, number])
  @@index([spaceId, status, updatedAt])
  @@index([spaceId, assigneeBotId])
  @@index([spaceId, assigneeUserId])
  @@map("crm_leads")
}

model CrmDeal {
  id              String          @id @default(cuid())
  spaceId         String
  space           Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  stage           String          @default("qualification")
  amount          Decimal         @default(0) @db.Decimal(14, 2)
  currency        String          @default("USD")
  expectedCloseAt DateTime?
  closedAt        DateTime?
  notes           String?
  companyId       String?
  company         CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         CrmContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerUserId     String?
  ownerBotId      String?
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sourceLead      CrmLead?        @relation("LeadConvertedDeal")
  activities      CrmActivity[]
  orders          ErpSalesOrder[]

  @@unique([spaceId, number])
  @@index([spaceId, stage, updatedAt])
  @@index([spaceId, companyId])
  @@map("crm_deals")
}

model CrmActivity {
  id              String      @id @default(cuid())
  spaceId         String
  space           Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind            String
  subject         String
  body            String?
  dueAt           DateTime?
  completedAt     DateTime?
  companyId       String?
  company         CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            CrmLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assigneeUserId  String?
  assigneeBotId   String?
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([spaceId, createdAt])
  @@index([spaceId, leadId])
  @@index([spaceId, dealId])
  @@index([spaceId, contactId])
  @@index([spaceId, completedAt, dueAt])
  @@map("crm_activities")
}

model ErpProduct {
  id              String                   @id @default(cuid())
  spaceId         String
  space           Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sku             String
  name            String
  description     String?
  unitPrice       Decimal                  @default(0) @db.Decimal(14, 2)
  currency        String                   @default("USD")
  active          Boolean                  @default(true)
  stockOnHand     Int                      @default(0)
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  adjustments     ErpInventoryAdjustment[]
  orderLines      ErpSalesOrderLine[]
  invoiceLines    ErpInvoiceLine[]

  @@unique([spaceId, sku])
  @@index([spaceId, active, name])
  @@map("erp_products")
}

model ErpInventoryAdjustment {
  id              String         @id @default(cuid())
  spaceId         String
  space           Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  productId       String
  product         ErpProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta           Int
  quantityAfter   Int
  reason          String
  orderId         String?
  order           ErpSalesOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByBotId  String?
  createdAt       DateTime       @default(now())

  @@index([spaceId, productId, createdAt])
  @@index([spaceId, createdAt])
  @@map("erp_inventory_adjustments")
}

model ErpSalesOrder {
  id                  String                   @id @default(cuid())
  spaceId             String
  space               Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number              Int
  status              String                   @default("draft")
  currency            String                   @default("USD")
  subtotal            Decimal                  @default(0) @db.Decimal(14, 2)
  notes               String?
  companyId           String?
  company             CrmCompany?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId           String?
  contact             CrmContact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId              String?
  deal                CrmDeal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  approvalRequestedAt DateTime?
  approvedAt          DateTime?
  approvedByUserId    String?
  approvedByBotId     String?
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  createdByUserId     String?
  createdByBotId      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  lines               ErpSalesOrderLine[]
  invoice             ErpInvoice?
  adjustments         ErpInventoryAdjustment[]

  @@unique([spaceId, number])
  @@index([spaceId, status, updatedAt])
  @@index([spaceId, companyId])
  @@index([spaceId, dealId])
  @@map("erp_sales_orders")
}

model ErpSalesOrderLine {
  id          String        @id @default(cuid())
  spaceId     String
  orderId     String
  order       ErpSalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     ErpProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal       @db.Decimal(14, 2)
  lineTotal   Decimal       @db.Decimal(14, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId, position])
  @@index([spaceId, productId])
  @@map("erp_sales_order_lines")
}

model ErpInvoice {
  id               String           @id @default(cuid())
  spaceId          String
  space            Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number           Int
  status           String           @default("draft")
  paymentStatus    String           @default("unpaid")
  currency         String           @default("USD")
  subtotal         Decimal          @default(0) @db.Decimal(14, 2)
  total            Decimal          @default(0) @db.Decimal(14, 2)
  amountPaid       Decimal          @default(0) @db.Decimal(14, 2)
  notes            String?
  orderId          String           @unique
  order            ErpSalesOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companyId        String?
  company          CrmCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  approvedByUserId String?
  approvedByBotId  String?
  createdByUserId  String?
  createdByBotId   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lines            ErpInvoiceLine[]

  @@unique([spaceId, number])
  @@index([spaceId, status, updatedAt])
  @@index([spaceId, paymentStatus])
  @@map("erp_invoices")
}

model ErpInvoiceLine {
  id          String      @id @default(cuid())
  spaceId     String
  invoiceId   String
  invoice     ErpInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     ErpProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  position    Int
  description String
  quantity    Int
  unitPrice   Decimal     @db.Decimal(14, 2)
  lineTotal   Decimal     @db.Decimal(14, 2)
  createdAt   DateTime    @default(now())

  @@index([invoiceId, position])
  @@map("erp_invoice_lines")
}

/// One row per executed business action: the audit trail and the idempotency
/// store. A repeated write with the same (spaceId, idempotencyKey) returns the
/// stored result instead of running again.
model BusinessActionLog {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actionId       String
  actionVersion  Int
  idempotencyKey String?
  recordType     String?
  recordId       String?
  actorUserId    String?
  actorBotId     String?
  runId          String?
  outcome        String
  errorCode      String?
  input          Json
  result         Json?
  createdAt      DateTime @default(now())

  @@unique([spaceId, idempotencyKey])
  @@index([spaceId, recordType, recordId, createdAt])
  @@index([spaceId, createdAt])
  @@map("business_action_log")
}

/// Domain events written in the same transaction as the state they describe.
/// `publishedAt` is the outbox marker for the live fanout.
model BusinessEvent {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  type        String
  recordType  String
  recordId    String
  payload     Json
  actorUserId String?
  actorBotId  String?
  runId       String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([spaceId, createdAt])
  @@index([publishedAt, createdAt])
  @@map("business_events")
}

/// The Frappe site (ERPNext + Frappe CRM) that answers for an organization's
/// business records once active. One per organization; every space shares it.
/// While none is active, the prototype CRM/ERP tables above answer.
model BusinessEnvironment {
  id                      String                    @id @default(cuid())
  organizationId          String                    @unique
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider                String                    @default("frappe")
  blueprintId             String
  blueprintVersion        Int
  siteUrl                 String
  siteName                String
  companyName             String
  companyAbbr             String
  country                 String
  currency                String
  status                  String
  installedApps           String[]                  @default([])
  /// Gateway user API key pair, sealed by the deployment secret store.
  credentialSecretId      String?
  credentialCiphertext    String?
  /// Shared secret the site signs event deliveries with, sealed the same way.
  webhookSecretId         String?
  webhookSecretCiphertext String?
  lastVerifiedAt          DateTime?
  lastError               String?
  createdByUserId         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  operations              BusinessOperation[]
  recordMappings          BusinessRecordMapping[]
  webhookDeliveries       BusinessWebhookDelivery[]

  @@map("business_environments")
}

/// Durable ledger of every write the gateway sends to a business environment.
/// The idempotency key is unique per environment, so a retry finds its row.
model BusinessOperation {
  id              String              @id @default(cuid())
  environmentId   String
  environment     BusinessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  spaceId         String
  actionId        String
  actionVersion   Int
  idempotencyKey  String
  status          String
  attempts        Int                 @default(0)
  actorUserId     String?
  actorBotId      String?
  runId           String?
  request         Json
  result          Json?
  errorCode       String?
  errorMessage    String?
  externalDoctype String?
  externalName    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?

  @@unique([environmentId, idempotencyKey])
  @@index([environmentId, status, updatedAt])
  @@index([spaceId, createdAt])
  @@map("business_operations")
}

/// Legacy prototype record to Frappe document, written by the migration tool.
model BusinessRecordMapping {
  id              String              @id @default(cuid())
  environmentId   String
  environment     BusinessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  recordType      String
  legacyId        String
  externalDoctype String
  externalName    String
  createdAt       DateTime            @default(now())

  @@unique([environmentId, recordType, legacyId])
  @@index([environmentId, externalDoctype, externalName])
  @@map("business_record_mappings")
}

/// Replay protection for signed event deliveries from the site.
model BusinessWebhookDelivery {
  id            String              @id @default(cuid())
  environmentId String
  environment   BusinessEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deliveryId    String
  eventType     String
  receivedAt    DateTime            @default(now())

  @@unique([environmentId, deliveryId])
  @@index([environmentId, receivedAt])
  @@map("business_webhook_deliveries")
}
