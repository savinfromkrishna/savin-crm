  stateHash    String   @unique
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  connectorId  String
  connectionId String
  provider     String
  scopes       String[] @default([])
  /// PKCE verifier and OpenID nonce, sealed by the secret store under this row id.
  ciphertext   String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@index([expiresAt])
  @@map("connector_authorizations")
}

