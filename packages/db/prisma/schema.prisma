/// An account authorized directly with a native connector, such as one Google account.
/// Connections reference it through providerRef; its tokens stay in the encrypted secret.
model ConnectorAccount {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectorId String
  /// Stable account id at the provider, such as Google's `sub` claim.
  subject     String
  email       String
  name        String    @default("")
  scopes      String[]  @default([])
  /// "active", or "reauthorize" once the provider rejects the stored grant.
  status      String    @default("active")
  lastError   String?
  secretId    String?   @unique
  secret      Secret?   @relation(fields: [secretId], references: [id], onDelete: SetNull)
  refreshedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([spaceId, userId, connectorId, subject])
  @@map("connector_accounts")
}

/// One in-flight OAuth authorization. Consumed by its callback; expires after ten minutes.
model ConnectorAuthorization {
  id           String   @id
